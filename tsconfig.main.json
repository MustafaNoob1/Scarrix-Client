{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"], "outDir": "dist-electron", "rootDir": "src/main",
    "types": ["node"], "esModuleInterop": true, "resolveJsonModule": true,
    "strict": true, "skipLibCheck": true
  },
  "include": ["src/main/**/*.ts"]
}
