{
  "name": "scarrix-client",
  "private": true,
  "version": "0.5.0",
  "description": "Community Minecraft Java Launcher for Scarrix.net (unofficial)",
  "author": {
    "name": "Scarrix Community",
    "email": "100511650+MustafaNoob1@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "tsc -p tsconfig.main.json",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env SCARRIX_DEV_SERVER=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "build": "tsc -p tsconfig.main.json && vite build",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.0",
    "@xmcl/core": "2.13.0",
    "@xmcl/installer": "5.4.0",
    "@xmcl/user": "4.4.2",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.6.0",
    "js-yaml": "^5.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.5",
    "skinview3d": "^3.4.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "net.scarrix.client",
    "productName": "Scarrix Client",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "update-channel.json",
        "to": "update-channel.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MustafaNoob1",
        "repo": "scarrix-client",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "publisherName": [
          "Scarrix Update Publisher"
        ]
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Scarrix-Client-${version}-${os}-${arch}.${ext}",
    "generateUpdatesFilesForAllChannels": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
